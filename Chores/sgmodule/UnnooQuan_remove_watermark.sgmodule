# 🪞 Mirrored by https://github.com/bunizao/Mirrored · source: https://kelee.one/Tool/Loon/Lpx/UnnooQuan_remove_watermark.lpx

[Body Rewrite]
http-response-jq (?i)^https:\/\/api\.zsxq\.com\/v2\/groups\/\d+$ 'if ((getpath(["resp_data","group","policies"]) // {}) | has("enable_watermark")) then (setpath(["resp_data","group","policies","enable_watermark"]; false)) else . end'

[MITM]
hostname = %APPEND% api.zsxq.com

