#!date=2026-08-24 18:59:19

[Map Local]
^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/kwd_top$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
body_rewrite_12 = type=http-response, pattern=^https:\/\/app\.5eplay\.com\/api\/app\/dync_config\?, script-path=https://github.com/bunizao/Mirrored/raw/main/Chores/js/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=%5B%5B%22json-del%22%2C%5B%22data.function_configs.startup_ad_switch%22%2C%22data.function_configs.startup_ad_timeout%22%2C%22data.function_configs.startup_ad_day_max%22%2C%22data.function_configs.app_bar_guide_width%22%2C%22data.function_configs.app_bar_guide_height%22%2C%22data.function_configs.app_bar_guide_url%22%2C%22data.function_configs.app_bar_guide_time%22%2C%22data.function_configs.home_tab_event_tag%22%2C%22data.function_configs.home_tab_event_tag_ext%22%2C%22data.function_configs.home_tab_player_tag%22%2C%22data.function_configs.home_tab_player_tag_ext%22%2C%22data.function_configs.task_center_entrance%22%2C%22data.function_configs.store_go%22%2C%22data.function_configs.wall_closed%22%5D%5D%5D

body_rewrite_13 = type=http-response, pattern=^https:\/\/app\.5eplay\.com\/api\/index\/tab_v\d\?category_id=tab_1&page=\d$, script-path=https://github.com/bunizao/Mirrored/raw/main/Chores/js/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=%5B%5B%22json-del%22%2C%5B%22data.float_advertise%22%5D%5D%5D

body_rewrite_15 = type=http-response, pattern=^https:\/\/ya-api-app\.5eplay\.com\/v\d\/search\/config$, script-path=https://github.com/bunizao/Mirrored/raw/main/Chores/js/body-rewrite.js, requires-body=true, max-size=-1, timeout=30, argument=%5B%5B%22json-del%22%2C%5B%22data.placeholder%22%5D%5D%5D

[MITM]
hostname = %APPEND% app.5eplay.com, ya-api-app.5eplay.com

